# ---------------------------------------------------------------------------
# Panel de Operacion del Cliente - ejemplo de variables de entorno
# ---------------------------------------------------------------------------
# Copie este archivo como `.env` y complete los valores. NUNCA versione el
# archivo `.env`: aqui no hay ningun secreto real, solo nombres de variables.
#
# GENERAR LOS SECRETOS
#   APP_KEY:        php artisan key:generate --show
#   POSTGRES_PASS:  openssl rand -base64 32
#   REDIS_PASS:     openssl rand -base64 32
# ---------------------------------------------------------------------------

# --- Aplicacion -------------------------------------------------------------
APP_NAME="Panel de Operacion del Cliente"
# OBLIGATORIA. Generar con `php artisan key:generate`.
APP_KEY=
APP_ENV=produccion
# En produccion siempre false: con debug activo Laravel puede incluir
# detalle interno en las respuestas de error.
APP_DEBUG=false
APP_URL=https://panel.ejemplo-hefesto.cl
APP_TIMEZONE=America/Santiago

# --- Base de datos (PostgreSQL) --------------------------------------------
DB_CONNECTION=pgsql
DB_HOST=postgres
DB_PORT=5432
DB_DATABASE=panel_operacion
# OBLIGATORIA
DB_USERNAME=panel_operacion
# OBLIGATORIA. La genera el despliegue, nunca se escribe a mano en un archivo.
DB_PASSWORD=

# ---------------------------------------------------------------------------
# Rol de arranque de PostgreSQL
# ---------------------------------------------------------------------------
# El rol de arriba es el de la APLICACION. Este es el de arranque: la imagen
# oficial lo crea como superusuario, asi que la aplicacion NUNCA conecta con el.
# Con superusuario, PostgreSQL ignora las politicas de Row Level Security y una
# empresa podria ver los datos de otra. Los dos detalles, en docs/03.
DB_ADMIN_USERNAME=panel_operacion_admin
DB_ADMIN_PASSWORD=

# Contra un servidor remoto, dejar en "require". Nunca "disable".
DB_SSLMODE=prefer

# --- Redis (cache de consultas) --------------------------------------------
CACHE_STORE=redis
REDIS_CLIENT=predis
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=

# --- Frontend (Nuxt) --------------------------------------------------------
# Imagenes del compose de produccion. Deben existir en el registro.
# OBLIGATORIA en produccion.
API_IMAGEN=hefesto/panel-operacion-api:0.1.0
WEB_IMAGEN=hefesto/panel-operacion-web:0.1.0

# Direccion interna de la API, vista desde el contenedor de Nuxt.
API_INTERNA=http://api:8000
NOMBRE_PANEL="Panel de Operacion del Cliente"

# --- Integraciones ----------------------------------------------------------
# Sistemas que esta instalacion decide consultar, separados por coma.
# Vacio = no se consulta nada y todas las tarjetas salen "desactivada".
# PANEL_INTEGRACIONES_ACTIVAS=uptime_kuma
PANEL_INTEGRACIONES_ACTIVAS=

# Tiempos de vida de la cache, en segundos. Mas alto = menos consultas a los
# sistemas externos, pero datos mas antiguos en pantalla.
PANEL_TTL_UPTIME_KUMA=120
PANEL_TTL_SIGNOZ=300
PANEL_TTL_KOPIA=900
PANEL_TTL_COOLIFY=300
PANEL_TTL_CROWDSEC=300
PANEL_TTL_AUTHENTIK=900

# Cuando se supera este umbral, la tarjeta pasa a "datos antiguos".
PANEL_VIEJO_UPTIME_KUMA=600
PANEL_VIEJO_SIGNOZ=1800
PANEL_VIEJO_KOPIA=3600
PANEL_VIEJO_COOLIFY=1800
PANEL_VIEJO_CROWDSEC=1800
PANEL_VIEJO_AUTHENTIK=3600

# Tiempo maximo de espera contra un sistema externo. Un backing service lento
# no puede dejar en blanco la pantalla del cliente.
PANEL_TIMEOUT_SEGUNDOS=5
PANEL_VIGENCIA_TOKEN_DIAS=30

# --- Uptime Kuma (unica integracion con cliente en este corte) -------------
# Ver docs/02-INTEGRACIONES.md antes de activar esto.
UPTIME_KUMA_HABILITADA=false
UPTIME_KUMA_URL=
# Clave de API del endpoint de metricas. Segun la documentacion oficial, esta
# clave NO da acceso a la interfaz web: solo permite leer metricas.
UPTIME_KUMA_CLAVE_API=
# Nunca false contra un servidor que no sea local.
UPTIME_KUMA_VERIFICAR_TLS=true

# --- Sistemas sin cliente verificado: NO rellenar --------------------------
# Estas credenciales estan declaradas para dejar constancia de que el panel
# las necesita. Mientras la integracion siga desactivada, no se usan.
SIGNOZ_URL=
SIGNOZ_CLAVE_API=
KOPIA_URL=
KOPIA_USUARIO=
KOPIA_CLAVE=
COOLIFY_URL=
COOLIFY_TOKEN_API=
CROWDSEC_LAPI_URL=
CROWDSEC_CLAVE_API=
AUTHENTIK_URL=
AUTHENTIK_TOKEN_API=