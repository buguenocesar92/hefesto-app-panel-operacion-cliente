{
    "name": "hefesto/panel-operacion-cliente",
    "type": "project",
    "description": "API del Panel de Operacion del Cliente de Hefesto Studio. Software propio de Hefesto: solo lectura sobre los sistemas que Hefesto administra. NO es un kit de despliegue de una herramienta de terceros.",
    "keywords": ["hefesto", "panel", "multitenant", "laravel", "solo-lectura"],
    "license": "proprietary",
    "require": {
        "php": "^8.3",
        "ext-json": "*",
        "ext-pdo": "*",
        "ext-openssl": "*",
        "laravel/framework": "^12.0",
        "predis/predis": "^2.2"
    },
    "require-dev": {
        "fakerphp/faker": "^1.24",
        "mockery/mockery": "^1.6",
        "nunomaduro/collision": "^8.6",
        "phpunit/phpunit": "^11.5"
    },
    "autoload": {
        "psr-4": {
            "App\\": "app/",
            "Database\\Factories\\": "database/factories/",
            "Database\\Seeders\\": "database/seeders/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": [
            "@php artisan config:clear --ansi",
            "@php artisan test"
        ],
        "test:aislamiento": [
            "@php artisan test --testsuite=Aislamiento"
        ]
    },
    "extra": {
        "laravel": {
            "dont-discover": []
        }
    },
    "config": {
        "optimize-autoloader": true,
        "preferred-install": "dist",
        "sort-packages": true
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}