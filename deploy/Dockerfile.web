# Imagen del frontend (Nuxt, SSR).
#
# Estado: este Dockerfile NO se ha construido. En el entorno donde se escribio
# el panel no habia Docker. Ver docs/10-PRUEBAS-Y-ESTADO.md.
#
# Version de Node: la que exige Nuxt 4.6.2 ("node": "^22.22.3 || ^24.15.0 ||
# >=26.0.0"), segun el registro de npm.

FROM node:24-bookworm-slim AS construccion

WORKDIR /app

# Dependencias primero para reaprovechar la capa.
COPY web/package.json web/package-lock.json* ./
RUN npm ci --no-audit --no-fund

COPY web/ ./
RUN npm run build

# -------------------------------------------------------------------

FROM node:24-bookworm-slim

ENV NODE_ENV=production
WORKDIR /app

# Usuario sin privilegios: el contenedor no corre como root.
RUN groupadd -r nuxt && useradd -r -g nuxt nuxt

COPY --from=construccion /app/.output ./.output
COPY deploy/entrypoint.web.sh /usr/local/bin/entrypoint
RUN chmod +x /usr/local/bin/entrypoint

USER nuxt

ENV NITRO_HOST=0.0.0.0
ENV NITRO_PORT=3000

EXPOSE 3000

ENTRYPOINT ["/usr/local/bin/entrypoint"]
CMD ["node", ".output/server/index.mjs"]